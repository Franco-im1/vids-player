{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "videoplayer",
  "version": "0.1.4",
  "identifier": "com.f1m.videoplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Player",
        "width": 1280,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkwM0NCNEQ2RkY3RUYyQTYKUldTbThuNy8xclE4a0Y4YVIrWlg0VTVNeHVyWVFHNzVmR1h2OUlaZGt0QmlCTzljQnJkSnRqUGUK",
      "endpoints": [
        "https://github.com/Franco-im1/vids-player/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      { "ext": ["mp4", "m4v"], "mimeType": "video/mp4" },
      { "ext": ["mkv"],        "mimeType": "video/x-matroska" },
      { "ext": ["webm"],       "mimeType": "video/webm" },
      { "ext": ["avi"],        "mimeType": "video/x-msvideo" },
      { "ext": ["mov", "qt"],  "mimeType": "video/quicktime" },
      { "ext": ["flv"],        "mimeType": "video/x-flv" },
      { "ext": ["wmv"],        "mimeType": "video/x-ms-wmv" }
    ]
  }
}
